# Local Docker Postgres, see docker-compose.yml.
# On Vercel, the Neon Marketplace integration injects DATABASE_URL — use the pooled connection string.
DATABASE_URL=postgresql://ruletheworld:ruletheworld@localhost:5433/ruletheworld

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Production = the Vercel deployment URL.
BETTER_AUTH_URL=http://localhost:3000
